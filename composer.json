{
    "name": "borz33/app",
    "description": "Borz33 — споделени PHP зависимости и миграции",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "dompdf/dompdf": "^3.1",
        "illuminate/database": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/translation": "^12.0",
        "illuminate/validation": "^12.0",
        "robmorgan/phinx": "^0.16",
        "symfony/mailer": "^7.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "Store\\": "web/app/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "migrate": "phinx migrate",
        "migrate:rollback": "phinx rollback",
        "migrate:status": "phinx status",
        "seed": "phinx seed:run",
        "seed:users": "phinx seed:run -s UserSeeder",
        "seed:products": "phinx seed:run -s ProductSeeder",
        "test:econt": "php tests/econt_configuration_test.php"
    }
}
