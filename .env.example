MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=borz33
MYSQL_USER=borz33
MYSQL_PASSWORD=borz33
MYSQL_PORT=3307

PLANS_PORT=2000
API_PORT=5000
PHPMYADMIN_PORT=8081
WEB_PORT=4000
ADMIN_PORT=3000
STORE_VITE_DEV_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:4000
DEV_RELOAD_ENABLED=true
ADMIN_ASSISTANT_ENABLED=true

# File storage: local keeps the current development behavior.
# For Cloudflare R2 set FILESYSTEM_DISK=r2 and fill all R2_* values.
FILESYSTEM_DISK=local
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=replace-with-r2-bucket
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_PUBLIC_URL=https://cdn.example.com
# LAN: open http://<this-pc-ip>:4000 and http://<this-pc-ip>:3000. Vite origin follows the request host.

# Cloudflare Tunnel (optional; activated with the Docker Compose "public" profile).
# Create a remotely-managed tunnel in Cloudflare Zero Trust and paste only its connector token here.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
CLOUDFLARE_WEB_HOST=dev.example.com
CLOUDFLARE_API_HOST=api-dev.example.com
STORE_VITE_PUBLIC_ORIGIN=https://dev.example.com
# Exact, comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,https://dev.example.com

ADMIN_EMAIL=admin@borz33.local
ADMIN_PASSWORD=admin12345
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Borz33

MAIL_DSN=smtp://mailpit:1025
MAIL_FROM_ADDRESS=noreply@borz33.local
MAIL_FROM_NAME=Borz33
ORDER_ADMIN_EMAIL=orders@borz33.local
MAILPIT_UI_PORT=8026
MAIL_VERIFICATION_TTL_MINUTES=15

COMPANY_NAME=Borz33
COMPANY_LEGAL_NAME=Борз 33 ЕООД
COMPANY_EIK=000000000
COMPANY_VAT=
COMPANY_MOL=
INVOICE_VAT_RATE=20
COMPANY_ADDRESS=ул. Примерна 1
COMPANY_CITY=София
COMPANY_POSTAL_CODE=1000
COMPANY_COUNTRY=България
COMPANY_PHONE=
COMPANY_EMAIL=info@borz33.local
COMPANY_WEBSITE=https://borz33.local
COMPANY_PRIVACY_URL=https://borz33.local/privacy
COMPANY_TERMS_URL=https://borz33.local/terms

# Econt API — demo/test. Само mode=calculate; не се създават товарителници.
ECONT_ENVIRONMENT=demo
ECONT_DEMO_API_BASE_URL=https://demo.econt.com/ee/services
ECONT_PRODUCTION_API_BASE_URL=https://ee.econt.com/services
ECONT_CALCULATE_PATH=Shipments/LabelService.createLabel.json
ECONT_CONNECTION_TEST_PATH=Profile/ProfileService.getClientProfiles.json
ECONT_DEMO_OFFICE_LOCATOR_URL=https://staging.officelocator.econt.com
ECONT_PRODUCTION_OFFICE_LOCATOR_URL=https://officelocator.econt.com
ECONT_DEMO_USERNAME=demo
ECONT_DEMO_PASSWORD=demo
ECONT_TRACKING_URL=https://ee.econt.com/load_direct.php
ECONT_TIMEOUT_SECONDS=8
ECONT_CURRENCY=EUR
ECONT_SENDER_NAME=Borz33 Demo
ECONT_SENDER_AGENT=Borz33 Demo
ECONT_SENDER_PHONE=0888888888
ECONT_SENDER_OFFICE_CODE=1000
ECONT_SENDER_CITY=София
ECONT_SENDER_POST_CODE=1000

# Generate once with: openssl rand -base64 32
# Keep the real value only in .env. Changing it makes saved encrypted credentials unreadable.
APP_ENCRYPTION_KEY=base64:replace-with-32-byte-base64-key

# OpenAI is used only by the backend for AI-assisted product form suggestions.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_PRODUCT_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60

AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_IP_MAX_ATTEMPTS=25
AUTH_DEVICE_CODE_TTL_MINUTES=15
AUTH_DEVICE_CODE_MAX_ATTEMPTS=5
AUTH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_RESET_TTL_MINUTES=60
ADMIN_PUBLIC_URL=http://localhost:3000
