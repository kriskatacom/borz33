# Econt API — demo/test. Само mode=calculate; не се създават товарителници.
ECONT_ENVIRONMENT=demo
ECONT_DEMO_API_BASE_URL=https://demo.econt.com/ee/services
ECONT_PRODUCTION_API_BASE_URL=https://ee.econt.com/services
ECONT_CALCULATE_PATH=Shipments/LabelService.createLabel.json
ECONT_CONNECTION_TEST_PATH=Profile/ProfileService.getClientProfiles.json
ECONT_DEMO_OFFICE_LOCATOR_URL=https://staging.officelocator.econt.com
ECONT_PRODUCTION_OFFICE_LOCATOR_URL=https://officelocator.econt.com
ECONT_DEMO_USERNAME=demo
ECONT_DEMO_PASSWORD=demo
ECONT_TRACKING_URL=https://ee.econt.com/load_direct.php
ECONT_TIMEOUT_SECONDS=8
ECONT_CURRENCY=EUR
ECONT_SENDER_NAME=Borz33 Demo
ECONT_SENDER_AGENT=Borz33 Demo
ECONT_SENDER_PHONE=0888888888
ECONT_SENDER_OFFICE_CODE=1000
ECONT_SENDER_CITY=София
ECONT_SENDER_POST_CODE=1000

# Generate once with: openssl rand -base64 32
# Keep the real value only in .env. Changing it makes saved encrypted credentials unreadable.
APP_ENCRYPTION_KEY=base64:replace-with-32-byte-base64-key

AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_IP_MAX_ATTEMPTS=25
AUTH_DEVICE_CODE_TTL_MINUTES=15
AUTH_DEVICE_CODE_MAX_ATTEMPTS=5
AUTH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_RESET_TTL_MINUTES=60
ADMIN_PUBLIC_URL=http://localhost:5173
