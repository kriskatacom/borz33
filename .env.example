WEB_PUBLIC_URL=http://localhost:8082
# LAN: open http://<this-pc-ip>:8082 and http://<this-pc-ip>:5173. Vite origin follows the request host.

# Cloudflare Tunnel (optional; activated with the Docker Compose "public" profile).
# Create a remotely-managed tunnel in Cloudflare Zero Trust and paste only its connector token here.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
CLOUDFLARE_WEB_HOST=dev.example.com
CLOUDFLARE_API_HOST=api-dev.example.com
STORE_VITE_PUBLIC_ORIGIN=https://dev.example.com
# Exact, comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8082,https://dev.example.com

ADMIN_EMAIL=admin@borz33.local
ADMIN_PASSWORD=admin12345
ADMIN_FIRST_NAME=Admin
