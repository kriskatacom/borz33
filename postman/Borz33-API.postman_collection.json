              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin/users?page=1&per_page=20&status=all",
            "description": "Списък. Query: q, role, status, page, per_page."
          },
          "response": []
        },
        {
          "name": "Create user",
          "request": {
