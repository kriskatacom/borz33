der\": 1,\n      \"option_values\": [\n        { \"option\": \"size\", \"value\": \"l\" },\n        { \"option\": \"color\", \"value\": \"white\" }\n      ]\n    }\n  ],\n  \"personalization_fields\": [\n    {\n      \"name\": \"Надпис\",\n      \"description\": \"До 16 символа. Без емоджи.\",\n      \"field_type\": \"text\",\n      \"is_required\": false,\n      \"max_length\": 16,\n      \"sort_order\": 0\n    }\n  ]\n}"
