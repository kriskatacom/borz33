{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Borz33 API",
    "description": "JSON API на Borz33. Локален адрес: http://localhost:8080 (Docker). Променливата `baseUrl` се сменя от Variables на колекцията.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('JSON success is true', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": "Проверка дали API-то работи. Очакван отговор: `{ success: true, message: \"API is running\", data: { name, status } }`."
          },
          "response": []
        },
        {
          "name": "Root",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('JSON success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/",
            "description": "Същият health отговор като GET /health."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('registerEmail', 'user' + Date.now() + '@example.com');",
                  "if (!pm.collectionVariables.get('deviceUuid')) {",
                  "    pm.collectionVariables.set('deviceUuid', (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : '11111111-1111-4111-8111-111111111111');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('JSON success and user payload', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.have.property('id');",
                  "    pm.expect(body.data.email).to.eql(pm.collectionVariables.get('registerEmail'));",
                  "    pm.expect(body.data.role).to.eql('customer');",
                  "    pm.expect(body.data).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Иван\",\n  \"last_name\": \"Петров\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"secret123\",\n  \"password_confirmation\": \"secret123\",\n  \"phone\": \"0888123456\",\n  \"device_uuid\": \"{{deviceUuid}}\",\n  \"device_name\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Регистрация на клиент. Задължително е `device_uuid` (UUID) — това устройство се счита за доверено. Изпраща 6-цифрен код към имейла (Mailpit). Успех: 201."
          },
          "response": []
        },
        {
          "name": "Register (validation error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('JSON errors object', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.errors).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Пример за невалидни данни. Очакван отговор: 422 и поле `errors`."
          },
          "response": []
        },
        {
          "name": "Verify email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 when code is valid', function () {",
                  "    pm.expect([200, 400, 422]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-email",
            "description": "Потвърждение с 6-цифрения код от писмото. Кодът се вижда в Mailpit (http://localhost:8026). Смени `code` преди изпращане. Успех: 200."
          },
          "response": []
        },
        {
          "name": "Resend verification code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-email/resend",
            "description": "Изпраща нов код, ако имейлът още не е потвърден. Админският имейл не получава писмо."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"secret123\",\n  \"device_uuid\": \"{{deviceUuid}}\",\n  \"device_name\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Вход от устройството на регистрацията. Изисква потвърден имейл. Успех връща Bearer token. Ново устройство: requires_device_verification и код по имейл. Заключване след 5 неуспешни опита за 15 мин (429)."
          },
          "response": []
        },
        {
          "name": "Login (new device)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('deviceUuidNew', (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : '22222222-2222-4222-8222-222222222222');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"secret123\",\n  \"device_uuid\": \"{{deviceUuidNew}}\",\n  \"device_name\": \"Other device\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Вход от друго устройство. Очакван отговор: код по имейл, без token."
          },
          "response": []
        },
        {
          "name": "Verify device login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"code\": \"123456\",\n  \"device_uuid\": \"{{deviceUuidNew}}\",\n  \"device_name\": \"Other device\"\n}"
            },
            "url": "{{baseUrl}}/auth/login/device",
            "description": "Потвърждава кода от Mailpit и издава token. Смени `code` преди изпращане."
          },
          "response": []
        },
        {
          "name": "Resend device login code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"device_uuid\": \"{{deviceUuidNew}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login/device/resend",
            "description": "Нов код за вход от ново устройство."
          },
          "response": []
        },
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@borz33.local\",\n  \"password\": \"admin12345\",\n  \"device_uuid\": \"{{deviceUuid}}\",\n  \"device_name\": \"Postman admin\"\n}"
            },
            "url": "{{baseUrl}}/auth/admin/login",
            "description": "Вход само за администратор. Създава админа от .env ако още го няма. Първото устройство се доверява автоматично."
          },
          "response": []
        },
        {
          "name": "Admin forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@borz33.local\"\n}"
            },
            "url": "{{baseUrl}}/auth/admin/password/forgot",
            "description": "Винаги връща еднакъв успех. Писмо се праща само на админски профил."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Текущ потребител по Bearer token. Сложи token от admin login в adminToken."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin users",
      "item": [
