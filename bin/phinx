#!/usr/bin/env sh
set -e
cd "$(dirname "$0")/.."

if [ -z "$(docker compose ps -q php 2>/dev/null)" ]; then
    echo "PHP контейнерът не работи. Пусни: docker compose up -d"
    exit 1
fi

if [ ! -x vendor/bin/phinx ]; then
    echo "Липсва vendor/. Инсталирам зависимости..."
    docker compose exec php composer install --no-interaction
fi

if [ -n "${USER_SEED_COUNT:-}" ] || [ -n "${PRODUCT_SEED_COUNT:-}" ]; then
    extra=""
    if [ -n "${USER_SEED_COUNT:-}" ]; then
        extra="${extra} -e USER_SEED_COUNT=${USER_SEED_COUNT}"
    fi
    if [ -n "${PRODUCT_SEED_COUNT:-}" ]; then
        extra="${extra} -e PRODUCT_SEED_COUNT=${PRODUCT_SEED_COUNT}"
    fi
    # shellcheck disable=SC2086
    docker compose exec $extra php vendor/bin/phinx "$@"
else
    docker compose exec php vendor/bin/phinx "$@"
fi
